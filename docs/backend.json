
{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a user's personal information and gamification progress.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "photoURL": { "type": "string" },
        "points": { "type": "number" },
        "currentStreak": { "type": "number" },
        "bestStreak": { "type": "number" },
        "earnedBadges": { "type": "array", "items": { "type": "string" } },
        "lastActivityDate": { "type": "string", "format": "date-time" },
        "weight": { "type": "number", "description": "Weight in lbs." },
        "height": { "type": "number", "description": "Height in inches." },
        "age": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email", "createdAt"]
    },
    "WorkoutSession": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "WorkoutSession",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "sessionDateTime": { "type": "string", "format": "date-time" },
        "durationMinutes": { "type": "number" },
        "notes": { "type": "string" },
        "estimatedCaloriesBurned": { "type": "number" },
        "type": { "type": "string" },
        "steps": { "type": "number" },
        "heartRate": { "type": "number" },
        "distance": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "sessionDateTime", "durationMinutes", "type", "createdAt"]
    },
    "FitnessGoal": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "FitnessGoal",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string", "enum": ["Steps", "Weight Loss", "Calories", "Activity"] },
        "targetValue": { "type": "number" },
        "currentValue": { "type": "number" },
        "targetUnit": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "name", "targetValue", "status", "createdAt"]
    },
    "FitnessGroup": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "FitnessGroup",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "ownerId": { "type": "string" },
        "members": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "ownerId", "members", "createdAt"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "UserProfile",
          "schema": { "$ref": "#/backend/entities/UserProfile" },
          "description": "User profiles with health and body stats."
        }
      },
      {
        "path": "/users/{userId}/workoutSessions/{sessionId}",
        "definition": {
          "entityName": "WorkoutSession",
          "schema": { "$ref": "#/backend/entities/WorkoutSession" },
          "description": "Logged workout sessions including heart rate and steps."
        }
      },
      {
        "path": "/users/{userId}/fitnessGoals/{goalId}",
        "definition": {
          "entityName": "FitnessGoal",
          "schema": { "$ref": "#/backend/entities/FitnessGoal" },
          "description": "Specific fitness targets for the user."
        }
      },
      {
        "path": "/groups/{groupId}",
        "definition": {
          "entityName": "FitnessGroup",
          "schema": { "$ref": "#/backend/entities/FitnessGroup" },
          "description": "Social groups for fitness tracking and collaboration."
        }
      }
    ]
  }
}
