
{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a user's personal information and gamification progress.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the UserProfile entity."
        },
        "name": {
          "type": "string",
          "description": "The user's full name."
        },
        "email": {
          "type": "string",
          "description": "The user's email address.",
          "format": "email"
        },
        "photoURL": {
          "type": "string",
          "description": "The URL of the user's profile picture."
        },
        "points": {
          "type": "number",
          "description": "Total gamification points earned."
        },
        "currentStreak": {
          "type": "number",
          "description": "Current consecutive days of activity."
        },
        "bestStreak": {
          "type": "number",
          "description": "The user's all-time best streak."
        },
        "earnedBadges": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of IDs for badges the user has earned."
        },
        "lastActivityDate": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of the last logged workout or meal."
        },
        "weight": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "email",
        "createdAt"
      ]
    },
    "NutritionLog": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "NutritionLog",
      "type": "object",
      "description": "Represents a meal or food item logged by a user.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "mealName": { "type": "string" },
        "calories": { "type": "number" },
        "protein": { "type": "number" },
        "carbs": { "type": "number" },
        "fat": { "type": "number" },
        "logDate": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "mealName", "calories", "logDate"]
    },
    "WorkoutSession": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "WorkoutSession",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "sessionDateTime": { "type": "string", "format": "date-time" },
        "durationMinutes": { "type": "number" },
        "notes": { "type": "string" },
        "estimatedCaloriesBurned": { "type": "number" },
        "type": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "sessionDateTime", "durationMinutes", "type", "createdAt"]
    },
    "FitnessGoal": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "FitnessGoal",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "targetValue": { "type": "number" },
        "currentValue": { "type": "number" },
        "targetUnit": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "name", "targetValue", "status", "createdAt"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "UserProfile",
          "schema": { "$ref": "#/backend/entities/UserProfile" },
          "description": "User profiles with gamification data."
        }
      },
      {
        "path": "/users/{userId}/nutritionLogs/{nutritionLogId}",
        "definition": {
          "entityName": "NutritionLog",
          "schema": { "$ref": "#/backend/entities/NutritionLog" }
        }
      },
      {
        "path": "/users/{userId}/workoutSessions/{workoutSessionId}",
        "definition": {
          "entityName": "WorkoutSession",
          "schema": { "$ref": "#/backend/entities/WorkoutSession" }
        }
      },
      {
        "path": "/users/{userId}/fitnessGoals/{fitnessGoalId}",
        "definition": {
          "entityName": "FitnessGoal",
          "schema": { "$ref": "#/backend/entities/FitnessGoal" }
        }
      }
    ]
  }
}
